    {
      "parameters": {
        "jsCode": "// The cart as the storefront sent it -> one tidy order.\nconst body  = $json.body ?? $json;\nconst items = Array.isArray(body.items) ? body.items : [];\n\nconst lines = items.map(i => ({\n  title: String(i.title ?? '').trim(),\n  qty: Number(i.qty ?? 1),\n  price: Number(i.price ?? 0),\n  line_total: Number(i.qty ?? 1) * Number(i.price ?? 0),\n}));\n\nconst total = lines.reduce((sum, l) => sum + l.line_total, 0);\nconst stamp = new Date();\nconst id = 'ORD-' + stamp.toISOString().slice(2, 10).replace(/-/g, '') + '-' +\n           String(Math.floor(Math.random() * 9000) + 1000);\n\nlet phone = String(body.customer_phone ?? '').replace(/[^\\d]/g, '');\nif (phone.startsWith('00')) phone = phone.slice(2);\nif (phone.startsWith('0'))  phone = '971' + phone.slice(1);\nif (phone.length === 9)     phone = '971' + phone;\n\nreturn [{\n  json: {\n    order_id: id,\n    created_at: stamp.toISOString(),\n    seller_handle: String(body.handle ?? '').toLowerCase(),\n    seller_phone: String(body.seller_phone ?? '').replace(/[^\\d]/g, ''),\n    customer_name: String(body.customer_name ?? '').trim(),\n    customer_phone: phone,\n    has_customer_phone: phone.length >= 10,\n    currency: body.currency ?? 'AED',\n    items_text: lines.map(l => `${l.qty}× ${l.title} — ${l.line_total} ${body.currency ?? 'AED'}`).join('\\n'),\n    items_json: JSON.stringify(lines),\n    item_count: lines.reduce((n, l) => n + l.qty, 0),\n    total,\n    status: 'new',\n  },\n}];"
      },
      "id": "build-the-order",
      "name": "Build the order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
