    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rentstore-signup",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "signup-submitted",
      "name": "Signup submitted",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -620,
        300
      ],
      "webhookId": "rentstore-signup"
    },
    {
      "parameters": {
        "jsCode": "// Normalise what the signup form sent and decide whether it is usable.\nconst body = $json.body ?? $json;\n\nconst name   = String(body.name   ?? '').trim();\nconst handle = String(body.handle ?? '').trim().toLowerCase().replace(/[^a-z0-9._-]/g, '');\nconst sells  = String(body.sells  ?? '').trim();\nconst plan   = body.plan === 'store' ? 'store' : 'free';\nconst email  = String(body.email  ?? '').trim();\n\n// UAE numbers: 0501234567 / +971501234567 / 971501234567 all end up as 971501234567\nlet phone = String(body.phone ?? '').replace(/[^\\d]/g, '');\nif (phone.startsWith('00')) phone = phone.slice(2);\nif (phone.startsWith('0'))  phone = '971' + phone.slice(1);\nif (phone.length === 9)     phone = '971' + phone;\n\nconst problems = [];\nif (name.length < 2)              problems.push('name');\nif (handle.length < 3)            problems.push('handle');\nif (!/^97\\d{9,10}$|^\\d{10,15}$/.test(phone)) problems.push('phone');\n\nreturn [{\n  json: {\n    valid: problems.length === 0,\n    problems,\n    name, handle, phone, email, sells, plan,\n    page_url: `https://${$env.RENTSTORE_DOMAIN || 'rentstore.ae'}/@${handle}`,\n    created_at: new Date().toISOString(),\n    status: 'active',\n    store_status: plan === 'store' ? 'requested' : 'off',\n    source: body.source ?? 'website',\n  },\n}];"
      },
      "id": "validate-and-normalise",
      "name": "Validate and normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "is-it-valid",
