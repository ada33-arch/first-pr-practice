        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', recipient_type: 'individual', to: $json.phone, type: 'text', text: { preview_url: true, body: =`أهلاً ${$json.name} 👋\\n\\nتم تسجيلك في رنت ستور.\\nصفحتك: ${$json.page_url}\\n\\nالخطوة الجاية: أرسل لنا صورتك، نبذة قصيرة، وروابط حساباتك — ونجهّز صفحتك خلال ٢٤ ساعة.\\n\\nوإذا حبيت تضيف متجر ومنتجات، رد بكلمة (متجر) ونرسل لك التفاصيل.` } }) }}",
        "options": {}
