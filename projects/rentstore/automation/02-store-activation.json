    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rentstore-stripe",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "stripe-says-it-was-paid",
      "name": "Stripe says it was paid",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -620,
        760
      ],
      "webhookId": "rentstore-stripe"
    },
    {
      "parameters": {
        "jsCode": "// Stripe posts every event here; keep only a completed payment.\nconst event   = $json.body ?? $json;\nconst type    = event.type ?? '';\nconst object  = event.data?.object ?? {};\nconst handle  = object.metadata?.handle ?? '';\nconst phone   = object.metadata?.phone ?? object.customer_details?.phone ?? '';\nconst paid    = ['checkout.session.completed', 'invoice.paid'].includes(type)\n                && (object.payment_status === 'paid' || object.status === 'paid' || type === 'invoice.paid');\n\nconst next = new Date(); next.setMonth(next.getMonth() + 1);\n\nreturn [{\n  json: {\n    paid, type, handle, phone,\n    amount: (object.amount_total ?? object.amount_paid ?? 0) / 100,\n    currency: (object.currency ?? 'aed').toUpperCase(),\n    store_status: 'active',\n    plan: 'store',\n    paid_at: new Date().toISOString(),\n    next_renewal: next.toISOString().slice(0, 10),\n    page_url: `https://${$env.RENTSTORE_DOMAIN || 'rentstore.ae'}/@${handle}`,\n  },\n}];"
      },
      "id": "read-the-stripe-event",
      "name": "Read the Stripe event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        760
      ]
    },
