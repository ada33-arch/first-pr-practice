    {
      "parameters": {
        "jsCode": "// Turn the request into the numbers the payment link needs.\nconst seller = $json;\nconst price  = Number($env.RENTSTORE_PRICE || 55);\nconst today  = new Date();\nconst next   = new Date(today); next.setMonth(next.getMonth() + 1);\n\nreturn [{\n  json: {\n    ...seller,\n    price,\n    currency: 'AED',\n    requested_at: today.toISOString(),\n    next_renewal: next.toISOString().slice(0, 10),\n    store_status: 'awaiting_payment',\n  },\n}];"
      },
      "id": "work-out-the-price-and-dates",
      "name": "Work out the price and dates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.stripe.com/v1/payment_links",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "line_items[0][price]",
              "value": "={{ $env.STRIPE_PRICE_ID }}"
            },
            {
              "name": "line_items[0][quantity]",
              "value": "1"
            },
            {
              "name": "metadata[handle]",
              "value": "={{ $json.handle }}"
            },
            {
              "name": "metadata[phone]",
              "value": "={{ $json.phone }}"
            }
          ]
        },
        "options": {}
      },
      "id": "create-the-payment-link",
      "name": "Create the payment link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ...$('Work out the price and dates').item.json, payment_link: $json.url, stripe_link_id: $json.id } }];"
      },
      "id": "keep-the-link-url",
      "name": "Keep the link URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SHEET_ID",
          "mode": "id"
