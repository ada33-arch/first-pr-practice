          "matchingColumns": [
            "handle"
          ],
          "schema": []
        },
        "options": {}
      },
      "id": "mark:-awaiting-payment",
      "name": "Mark: awaiting payment",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WA_PHONE_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', recipient_type: 'individual', to: $json.phone, type: 'text', text: { preview_url: true, body: =`تفعيل المتجر 🛍️\\n\\nالمتجر: ${$json.price} د.إ شهرياً، تقدر توقفه في أي وقت.\\n\\nاللي بيوصلك:\\n• منتجات بلا حد مع صور وأسعار\\n• صفحة لكل منتج وتصنيفات وبحث\\n• سلة وطلبات توصلك واتساب مباشرة\\n• تستلم المبلغ من الزبون مباشرة، بدون نسبة علينا\\n\\nرابط الدفع: ${$json.payment_link}\\n\\nبعد الدفع يتفعّل متجرك خلال دقائق.` } }) }}",
        "options": {}
      },
      "id": "whatsapp:-send-the-payment-link",
      "name": "WhatsApp: send the payment link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WA_PHONE_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', recipient_type: 'individual', to: $env.OWNER_PHONE, type: 'text', text: { preview_url: true, body: =`💳 طلب تفعيل متجر\\n\\n${$json.name} — ${$json.handle}\\nواتساب: ${$json.phone}\\nأُرسل له رابط الدفع (${$json.price} د.إ / شهر).` } }) }}",
        "options": {}
      },
      "id": "whatsapp:-tell-the-owner-a-store-was-requested",
      "name": "WhatsApp: tell the owner a store was requested",
