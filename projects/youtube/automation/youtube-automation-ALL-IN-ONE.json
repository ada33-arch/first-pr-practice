      },
      "id": "set3",
      "name": "Read the tap",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        0,
        2240
      ],
      "notes": "Splits the callback_data 'approve|7' or 'reject|7' back into a decision and a row.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
