    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ new Date($json.scheduled_datetime) <= new Date() }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      },
      "id": "if4",
      "name": "Scheduled time reached?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2260,
        200
      ]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "mode": "id",
          "value": "={{ $json.edited_file_link }}"
        }
      },
      "id": "dl4",
      "name": "Download edited file",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 1,
      "position": [
        1820,
        430
      ],
      "notes": "Pulls the finished, Claude-enhanced cut from Drive, ready to hand to YouTube.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $json.title }}",
        "regionCode": "US",
        "categoryId": "22",
        "options": {
          "description": "={{ $json.description }}",
          "tags": "={{ $json.tags }}",
          "privacyStatus": "public"
        }
      },
      "id": "yt4",
      "name": "Upload to YouTube",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [
        2040,
        430
      ],
      "notes": "Needs a Google Cloud project with the YouTube Data API v3 enabled and OAuth2 credentials in n8n — see the setup note. Not set up yet, so this node will fail until it is.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "mode": "list",
          "value": "REPLACE_WITH_SHEET_ID"
        },
        "sheetName": {
          "mode": "list",
          "value": "Content Calendar"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "row_number"
