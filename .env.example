# Copy to .env and fill in. .env is gitignored.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=

# Optional: override the default model (claude-opus-5).
# AGENT_MODEL=claude-opus-5

# Optional: Composio tool router MCP endpoint. Generate this URL from the
# Composio dashboard. Without it the agent runs with built-in tools only.
# COMPOSIO_MCP_URL=

# Optional: only needed if your Composio endpoint expects a bearer token
# rather than carrying auth in the URL itself.
# COMPOSIO_API_KEY=

# Optional: Pinterest API v5, used by `npm run pinterest`. App ID and secret
# come from https://developers.pinterest.com/apps/; the redirect URI must be
# registered on that app exactly as written here.
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=
# PINTEREST_REDIRECT_URI=http://localhost:8085/
# Filled in from `npm run pinterest -- token <code>`.
# PINTEREST_ACCESS_TOKEN=
# PINTEREST_REFRESH_TOKEN=
# Trial-access apps can only write to the sandbox:
# PINTEREST_API_BASE=https://api-sandbox.pinterest.com/v5
# Optional: the public URL of the rentstore pages, for `npm run pins`. Pins
# link to <this>/product.html?id=<product> with utm tags. Unset = no link.
# RENTSTORE_URL=https://rentstore.ae
