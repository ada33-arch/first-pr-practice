        "jsCode": "// You move the case forward by posting its new stage; the customer hears about it.\nconst body  = $json.body ?? $json;\nconst stage = String(body.stage ?? '').trim();\nconst known = ['docs_received', 'filed', 'licence_issued', 'store_live'];\n\nreturn [{\n  json: {\n    case_id: String(body.case_id ?? '').trim(),\n    phone: String(body.phone ?? '').replace(/[^\\d]/g, ''),\n    name: String(body.name ?? '').trim(),\n    stage,\n    known: known.includes(stage),\n    note: String(body.note ?? '').trim(),\n    updated_at: new Date().toISOString(),\n  },\n}];"
      },
