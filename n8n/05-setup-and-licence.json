    {
      "parameters": {
        "jsCode": "// A setup request is a case that runs for days, so it gets an id and a stage.\nconst body = $json.body ?? $json;\n\nlet phone = String(body.phone ?? '').replace(/[^\\d]/g, '');\nif (phone.startsWith('00')) phone = phone.slice(2);\nif (phone.startsWith('0'))  phone = '971' + phone.slice(1);\nif (phone.length === 9)     phone = '971' + phone;\n\nconst stamp = new Date();\nconst id = 'SETUP-' + stamp.toISOString().slice(2, 10).replace(/-/g, '') + '-' +\n           String(Math.floor(Math.random() * 900) + 100);\n\nreturn [{\n  json: {\n    case_id: id,\n    created_at: stamp.toISOString(),\n    name: String(body.name ?? '').trim(),\n    handle: String(body.handle ?? '').trim().toLowerCase(),\n    phone,\n    emirate: String(body.emirate ?? '').trim(),        // filled in on the call\n    activity: String(body.sells ?? body.activity ?? '').trim(),\n    licence_type: '',                                   // decided on the call\n    stage: 'new',\n    fee: Number($env.MATJARI_SETUP_FEE || 1500),\n    valid: phone.length >= 10 && String(body.name ?? '').trim().length > 1,\n  },\n}];"
      },
