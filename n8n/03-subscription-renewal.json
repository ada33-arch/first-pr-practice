    {
      "parameters": {
        "jsCode": "// One row per active store; decide what today means for each one.\nconst grace = Number($env.MATJARI_GRACE_DAYS || 7);\nconst today = new Date(); today.setHours(0, 0, 0, 0);\nconst out = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  if (String(row.store_status) !== 'active' && String(row.store_status) !== 'overdue') continue;\n  if (!row.next_renewal) continue;\n\n  const due  = new Date(row.next_renewal); due.setHours(0, 0, 0, 0);\n  const days = Math.round((due - today) / 86400000);   // + = still to come, - = late\n\n  let stage = null;\n  if (days === 3)          stage = 'reminder';         // three days before\n  else if (days === 0)     stage = 'due_today';\n  else if (days === -3)    stage = 'overdue';\n  else if (days <= -grace) stage = 'suspend';\n  if (!stage) continue;\n\n  out.push({ json: { ...row, days, stage, checked_at: today.toISOString().slice(0, 10) } });\n}\n\nreturn out;"
      },
